# Contrato de entorno compartido del orquestador.
# Copiar a .env y definir ambos tokens obligatorios antes de ejecutar Docker Compose.

# Compose publica este puerto del host; el contenedor siempre escucha en 8080.
# Elegir un puerto libre: 8080 suele estar ocupado por el Extract.
ORCHESTRATOR_PORT=8081
# Para `go run`/`make run` local, el listener por defecto es 8099 (ver Makefile).
PORT=8099

# Servicios upstream. El tráfico E-W pasa por el Traefik compartido de
# Documents/Services (red `mired`, entrada `https` con TLS), nunca por DNS
# directo a los contenedores. El compose resuelve estos nombres a la IP del
# contenedor `traefik` en `mired` (`TRAEFIK_EW_HOST`) y valida el certificado
# con la CA de mkcert. `make up` detecta esa IP sola; si usás `docker compose`
# directo, exportá `TRAEFIK_EW_HOST` con la IP de `traefik` en `mired`.
TRAEFIK_EW_HOST=
EXTRACT_BASE_URL=https://extract.universidad.localhost
PERSISTENCE_BASE_URL=https://persistence.universidad.localhost
AUDIT_LOG_BASE_URL=https://audit.universidad.localhost

# Health checks a través del mismo Traefik compartido.
EXTRACT_HEALTH_URL=https://extract.universidad.localhost/healthz
PERSISTENCE_HEALTH_URL=https://persistence.universidad.localhost/readyz
AUDIT_LOG_HEALTH_URL=https://audit.universidad.localhost/readyz
HEALTH_CHECK_TIMEOUT=2s
LOG_MAX_VALUE_LENGTH=256
# Opcional en Consul y en el entorno; por defecto 4096.
LOG_MAX_STACK_LENGTH=4096

# CA raíz de mkcert que firma el certificado de *.universidad.localhost servido
# por el Traefik compartido de Documents/Services. Se monta en el contenedor y se
# exporta como SSL_CERT_FILE. No es el cert hoja (cert.pem), es la raíz que lo
# firma; el compose asume el symlink en Documents/Services/traefik/certs.
TRAEFIK_CA_FILE=${HOME}/Documents/Services/traefik/certs/rootCA.pem

# Credenciales de servicio obligatorias. Mantener vacías hasta que las provea un
# gestor de secretos o un archivo .env local no versionado.
AUDIT_LOG_API_TOKEN=
PERSISTENCE_API_TOKEN=

# Timeouts y límites de payload.
HTTP_TIMEOUT=35s
SHUTDOWN_TIMEOUT=35s
STOP_GRACE_PERIOD=45s
MAX_PDF_SIZE_BYTES=15MB
MAX_TEXT_BODY_BYTES=15MB
MAX_PDF_PAGES=1000
# Logging estructurado.
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Consul (opcional) -----------------------------------------------------
# Deshabilitado por defecto: con false toda la configuración sale del entorno.
# Con true se lee primero el prefijo KV y el entorno sigue siendo fallback; en
# ese caso CONSUL_HTTP_ADDR y CONSUL_KV_PREFIX son obligatorios.
CONSUL_ENABLED=false
# Consul queda fuera de alcance de este compose standalone. Si se habilita, usar
# su propia CA (consul-ca.pem, no la de Traefik) y montarla en el contenedor.
# CONSUL_HTTP_ADDR=https://consul:8501
# CONSUL_HTTP_TOKEN=
# CONSUL_KV_PREFIX=pdf-extractext/dev/orchestrator
# CONSUL_SERVICE_NAME=orchestrator
