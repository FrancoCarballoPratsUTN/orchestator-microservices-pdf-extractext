# Contrato de entorno compartido del orquestador.
# Copiar a .env y definir ambos tokens obligatorios antes de ejecutar Docker Compose.

# Compose publica este puerto del host; el contenedor siempre escucha en 8080.
# Para `go run` local, definir PORT en un puerto disponible, por ejemplo 8099.
ORCHESTRATOR_PORT=8080
PORT=8080

# Servicios upstream. Usar nombres DNS de Docker en Compose y direcciones
# localhost sólo cuando el orquestador se ejecuta directamente en el host.
EXTRACT_BASE_URL=http://app:8080
PERSISTENCE_BASE_URL=http://persistence:8000
AUDIT_LOG_BASE_URL=http://pdf-extractext-auditlog:8083

# Health checks dentro de la red de Docker.
EXTRACT_HEALTH_URL=http://app:8080/healthz
PERSISTENCE_HEALTH_URL=http://persistence:8000/readyz
AUDIT_LOG_HEALTH_URL=http://pdf-extractext-auditlog:8083/readyz
HEALTH_CHECK_TIMEOUT=2s
LOG_MAX_VALUE_LENGTH=256
# Opcional en Consul y en el entorno; por defecto 4096.
LOG_MAX_STACK_LENGTH=4096

# Credenciales de servicio obligatorias. Mantener vacías hasta que las provea un
# gestor de secretos o un archivo .env local no versionado.
AUDIT_LOG_API_TOKEN=
PERSISTENCE_API_TOKEN=

# Timeouts y límites de payload.
HTTP_TIMEOUT=35s
SHUTDOWN_TIMEOUT=35s
STOP_GRACE_PERIOD=45s
MAX_PDF_SIZE_BYTES=15MB
MAX_TEXT_BODY_BYTES=15MB
MAX_PDF_PAGES=1000
# Logging estructurado.
LOG_LEVEL=info
LOG_FORMAT=json
