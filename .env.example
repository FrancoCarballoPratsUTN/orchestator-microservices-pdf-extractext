# Shared environment contract for the orchestrator.
# Copy to .env and set both required tokens before running Docker Compose.

# Public host port. The container always listens on 8080.
ORCHESTRATOR_PORT=8080
PORT=8080

# Upstream services. Use Docker DNS names in Compose and localhost addresses
# only when running the orchestrator directly on the host.
EXTRACT_BASE_URL=http://app:8080
PERSISTENCE_BASE_URL=http://persistence:8000
AUDIT_LOG_BASE_URL=http://pdf-extractext-auditlog:8083

# Required service credentials. Keep empty until supplied by a secret manager
# or a local, untracked .env file.
AUDIT_LOG_API_TOKEN=
PERSISTENCE_API_TOKEN=

# Timeouts and payload limits.
HTTP_TIMEOUT=35s
SHUTDOWN_TIMEOUT=35s
STOP_GRACE_PERIOD=45s
MAX_PDF_SIZE_BYTES=15MB
MAX_TEXT_BODY_BYTES=15MB
MAX_PDF_PAGES=1000

# Structured logging.
LOG_LEVEL=info
LOG_FORMAT=json
